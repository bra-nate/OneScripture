{
  "name": "onescripture",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike": "tsx --env-file-if-exists=.env.local scripts/bible-spike.ts",
    "kokoro:proof": "bash scripts/kokoro-phase0.sh",
    "kokoro:proof:male": "bash scripts/kokoro-phase0.sh --voice am_michael --output-dir artifacts/kokoro-phase0/am_michael",
    "scripture:import:web": "tsx --env-file-if-exists=.env.local scripts/import-web-catalogue.ts",
    "scripture:verify": "tsx --env-file-if-exists=.env.local scripts/verify-scripture-catalogue.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
