# Required service targets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
ONESCRIPTURE_APP_URL=https://scripture.example.com

# Point this at the filesystem that holds worker cache and temporary audio.
ONESCRIPTURE_DISK_PATH=/var/lib/onescripture

# Optional. Receives the JSON health report on warning or critical results.
ONESCRIPTURE_ALERT_WEBHOOK_URL=https://alerts.example.com/onescripture
